# PSCO 前端本地开发环境变量样例
#
# 复制为 .env 并按需修改。.env 已在 .gitignore 中忽略，不会进入版本控制。
# 当前阶段（phase03-14 联调验收）的默认复核口径是“真实前后端联调”，
# 不再把 mock 作为默认验收入口。

# 是否切换到真实后端 API
#   true   → 使用真实 Go 后端（当前 phase03 联调默认值）
#   false  → 仅保留给局部前端演示/历史 phase02 场景，不作为当前验收入口
VITE_USE_REAL_API=true

# 后端 API 基础 URL（仅 VITE_USE_REAL_API=true 时生效）
# 开发期间默认留空：由 Vite dev server 将 /api 同源代理到 http://localhost:8081
# 生产环境可按部署入口注入实际地址。
VITE_API_BASE_URL=
