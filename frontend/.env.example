# PSCO 前端本地开发环境变量样例
#
# 复制为 .env 并按需修改。.env 已在 .gitignore 中忽略，不会进入版本控制。
# 上游规格：phase02-11 spec §"前端临时适配层必须能切换到真实后端"

# 是否切换到真实后端 API
#   true   → 使用真实 Go 后端（需先启动 backend/bin/psco-server）
#   未设置 → 使用 mock 数据（phase02-10 默认行为，无需后端）
VITE_USE_REAL_API=false

# 后端 API 基础 URL（仅 VITE_USE_REAL_API=true 时生效）
VITE_API_BASE_URL=http://localhost:8080
