# PSCO 后端本地开发环境变量样例
#
# 复制为 .env 并按需修改。.env 已在 .gitignore 中忽略，不会进入版本控制。
# 上游规格：phase02-11 spec §"本地开发环境必须复用共享 PostgreSQL 容器"
#
# 约束：
#   - DATABASE_URL 必须为显式最终值，不依赖嵌套环境变量拼接
#   - 密码含 /、=、@ 等特殊字符时必须做 URL 编码
#   - 凭据应通过本地 .env 文件注入，不应把敏感值硬编码进仓库源码
#   - 复用现有 Podman PostgreSQL 容器（宿主机端口 55432），不新开第二个容器
#   - PSCO 在共享实例中使用独立数据库（psco_development），不复用 rento_production
#
# 获取本地 Podman PostgreSQL 密码（rento-preview-postgres 容器）：
#   podman exec rento-preview-postgres printenv POSTGRES_PASSWORD
# 若密码含特殊字符，需做 URL 编码后再拼入 DATABASE_URL。

# 数据库连接（显式最终值）
# 将 YOUR_LOCAL_PG_PASSWORD 替换为本地实际密码，特殊字符需 URL 编码
DATABASE_URL=postgresql://rento:YOUR_LOCAL_PG_PASSWORD@127.0.0.1:55432/psco_development

# 迁移与种子文件目录（相对项目根，由 cmd/server 启动时的工作目录解析）
MIGRATIONS_DIR=database/migrations
SEEDS_DIR=database/seeds

# 启动时是否自动执行种子数据（幂等）
#   - true:  本地开发联调时启用，启动后自动初始化候选数据
#   - false: 默认值，生产环境保持关闭；可改用 database/scripts/run_seeds.sh 独立执行
RUN_SEEDS_ON_BOOT=false

# HTTP 服务端口
HTTP_PORT=8080
